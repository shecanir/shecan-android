<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@color/profileBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="96dp">

        <TextView
            android:id="@+id/tvStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:gravity="end"
            android:textAlignment="viewEnd"
            android:textColor="@color/greenSecondaryTextColor"
            android:textSize="12sp"
            tools:text="پرداخت از طریق سایت" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_billing_plan_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/billing_select_service"
                android:textAlignment="viewEnd"
                android:textColor="@color/primaryTextColor"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerService"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_billing_spinner_field"
                android:layoutDirection="rtl"
                android:paddingHorizontal="12dp"
                android:popupBackground="@drawable/bg_billing_spinner_popup"
                android:textDirection="rtl"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:text="@string/billing_select_period"
                android:textAlignment="viewEnd"
                android:textColor="@color/primaryTextColor"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerPeriod"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_billing_spinner_field"
                android:layoutDirection="rtl"
                android:paddingHorizontal="12dp"
                android:popupBackground="@drawable/bg_billing_spinner_popup"
                android:textDirection="rtl"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:id="@+id/featuresBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_billing_chip"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tvFeatureOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="سرعت: تا 40Mbps" />

                <TextView
                    android:id="@+id/tvFeatureTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="تعداد درخواست DNS تخمینی روزانه: 2000" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDiscountToggle"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_billing_chip"
                android:gravity="center_vertical|end"
                android:paddingHorizontal="12dp"
                android:text="@string/billing_have_discount_code"
                android:textAlignment="viewEnd"
                android:textColor="@color/orangeMain"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/discountRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_billing_spinner_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/btnApplyDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:text="@string/billing_apply_discount"
                    android:textColor="@color/orangeMain"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClearDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:text="@string/billing_remove_discount"
                    android:textColor="@color/red"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etDiscountCode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:gravity="end|center_vertical"
                    android:hint="@string/billing_discount_hint"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/primaryTextColor"
                    android:textColorHint="@color/greenSecondaryTextColor"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDiscountMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="کد تخفیف معتبر نیست"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="خطا در دریافت قیمت"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvDueDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:textColor="@color/primaryTextColor"
                android:textSize="12sp"
                tools:text="تاریخ انقضای سرویس: ۱۴۰۵/۰۳/۲۹" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/dividerColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvServicePrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="۳۸۵٬۰۰۰ تومان" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/billing_service_amount"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/discountAmountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvDiscountAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="@color/greenMain"
                    android:textSize="14sp"
                    tools:text="۵۰٬۰۰۰ تومان" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/billing_discount_amount"
                    android:textColor="@color/greenMain"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/discountedServiceAmountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvDiscountedServicePrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="۳۳۵٬۰۰۰ تومان" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/billing_service_amount_after_discount"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTax"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    tools:text="۰ تومان" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/billing_tax"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/dividerColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="۳۸۵٬۰۰۰ تومان" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/billing_total"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:text="@string/billing_support_warning"
            android:textAlignment="viewEnd"
            android:textColor="@color/primaryTextColor"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/checkboxRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:buttonTint="@color/greenMain"
            android:fontFamily="@font/iran_yekan_bakh_vm"
            android:gravity="start|center_vertical"
            android:layoutDirection="rtl"
            android:lineSpacingExtra="2dp"
            android:minHeight="42dp"
            android:text="@string/billing_accept_rules"
            android:textAlignment="viewStart"
            android:textColor="@color/primaryTextColor"
            android:textDirection="rtl"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_billing_pay_button"
            android:backgroundTint="@null"
            android:enabled="true"
            android:text="@string/billing_pay"
            android:textAllCaps="false"
            android:textColor="@color/billing_pay_button_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/paymentOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/billingPaymentOverlayBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/greenMain" />

        <TextView
            android:id="@+id/tvPaymentLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/billing_payment_loading"
            android:textColor="@color/primaryTextColor"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
