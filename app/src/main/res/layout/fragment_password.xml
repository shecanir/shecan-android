<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/authorizeBackgroundColor">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:id="@+id/bottomFrameLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="115dp"
                        android:background="@drawable/login_top_box_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:layout_marginVertical="12dp">

                                <EditText
                                    android:id="@+id/edtPassword"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPassword"
                                    android:background="@drawable/edittext_rounded_box"
                                    android:padding="14dp"
                                    android:paddingHorizontal="24dp"
                                    android:gravity="start"
                                    android:textAlignment="viewStart"
                                    android:textDirection="ltr"
                                    android:layoutDirection="ltr"
                                    android:hint="@string/password"
                                    android:fontFamily="@font/iran_yekan_light"
                                    android:textColor="@color/greenPrimaryTextColor"
                                    android:textColorHint="@color/greenPrimaryTextColor"
                                    android:textSize="14sp" />

                                <!-- Eye icon -->
                                <ImageView
                                    android:id="@+id/btnEye"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:padding="12dp"
                                    android:layout_gravity="start|center_vertical"
                                    android:layout_marginStart="4dp"
                                    android:src="@drawable/ic_eye_close"
                                    android:clickable="true"
                                    android:focusable="false" />

                            </FrameLayout>


                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:layout_marginVertical="16dp"
                                android:layout_marginHorizontal="24dp"
                                android:background="@color/dividerColor"/>

                            <!-- Button -->

                            <ir.shecan.ui.widget.CustomButton
                                android:id="@+id/btnContinue"
                                style="@style/CustomButtonStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="8dp"
                                android:text="@string/login" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:layout_marginVertical="16dp"
                                android:layout_marginHorizontal="24dp"
                                android:background="@color/dividerColor"/>

                            <ir.shecan.ui.widget.CustomButton
                                android:id="@+id/btnContinueWithOtpCode"
                                style="@style/CustomButtonStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="8dp"
                                android:text="@string/loginWithOtp"
                                app:type="secondary"/>

                        </LinearLayout>


                    </FrameLayout>

                    <!-- آدمک -->
                    <ImageView
                        android:id="@+id/mascot"
                        android:layout_width="170dp"
                        android:layout_height="170dp"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/ic_shecan_normal" />

                </RelativeLayout>

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="100dp">

        <ImageView
            android:id="@+id/iconToolbarOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/toolbar_logo_vertical"
            android:transitionName="toolbar_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iconBackImg"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:alpha="0"
            android:background="@drawable/back_button_background"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:rotation="180"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <ProgressBar
        android:id="@+id/progressVerify"
        android:indeterminateTint="@color/greenMain"
        android:indeterminateTintMode="src_in"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_width="36dp"
        android:layout_height="36dp" />

</FrameLayout>
