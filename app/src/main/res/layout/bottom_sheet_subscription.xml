<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="20dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:orientation="vertical"
    android:background="@drawable/bg_bottomsheet">

    <!-- header row: support button, status chip, chevron -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/icon_circle_background"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_bottom"
            android:contentDescription=""
            app:tint="@color/greenDark" />
        <FrameLayout android:layout_width="8dp" android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/statusBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_status_box">

            <ImageView
                android:id="@+id/statusBoxIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_alert" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/expiring"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#EE5F1D"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_config_detail">

            <TextView
                android:id="@+id/btnSupport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="3dp"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/greenSecondaryTextColor"
                android:text="@string/support"
                />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/dividerStrokeColor"/>

    <FrameLayout
        android:id="@+id/cardInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

               <LinearLayout
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:gravity="center"
                   android:orientation="vertical">

                   <TextView
                       android:id="@+id/tvOrderCode"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_gravity="start"
                       android:text="@string/order_code"
                       android:textSize="13sp"
                       android:textColor="@color/greenSecondaryTextColor" />

                   <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                   <TextView
                       android:id="@+id/tvOrderCodeBody"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_gravity="start"
                       tools:text="321311"
                       android:textSize="13sp"
                       android:textStyle="bold"
                       android:textColor="@color/primaryTextColor" />

               </LinearLayout>

               <LinearLayout
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:gravity="center"
                   android:orientation="vertical">

                   <TextView
                       android:id="@+id/tvServiceType"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_gravity="start"
                       android:text="@string/serviceType"
                       android:textSize="13sp"
                       android:textColor="@color/greenSecondaryTextColor" />

                   <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                   <TextView
                       android:id="@+id/tvServiceTypeBody"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_gravity="start"
                       android:text="@string/bronze"
                       android:textSize="13sp"
                       android:textStyle="bold"
                       android:textColor="@color/primaryTextColor" />

               </LinearLayout>

               <LinearLayout
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_weight="1"
                   android:gravity="center"
                   android:orientation="vertical">

                   <TextView
                       android:id="@+id/tvCompanyName"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_gravity="start"
                       android:text="@string/company_name"
                       android:textSize="13sp"
                       android:textColor="@color/greenSecondaryTextColor" />

                   <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                   <TextView
                       android:id="@+id/tvCompanyNameBody"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       tools:text="-"
                       android:layout_gravity="start"
                       android:textSize="13sp"
                       android:textStyle="bold"
                       android:textColor="@color/primaryTextColor" />

               </LinearLayout>

            </LinearLayout>

            <!-- second row: dates -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPayCycleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="@string/pay_cycle"
                        android:textSize="12sp"
                        android:textColor="@color/greenSecondaryTextColor" />

                    <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                    <TextView
                        android:id="@+id/tvPayCycleBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="@string/billing_period_monthly"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/primaryTextColor" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStartDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="@string/start_date"
                        android:textSize="12sp"
                        android:textColor="@color/greenSecondaryTextColor" />

                    <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                    <TextView
                        android:id="@+id/tvStartDateBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        tools:text="1404/05/28"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/primaryTextColor" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEndDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="@string/expire_date"
                        android:textSize="12sp"
                        android:textColor="@color/greenSecondaryTextColor" />

                    <FrameLayout android:layout_width="8dp" android:layout_height="8dp" />

                    <TextView
                        android:id="@+id/tvEndDateBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        tools:text="1404/06/28"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/primaryTextColor" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/cardWaitingForActivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_round_button"
        app:layout_constraintTop_toBottomOf="@id/cardInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical"
            android:gravity="start">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/check_service_status"
                android:textColor="@color/primaryTextColor"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="8dp"
                android:paddingHorizontal="16dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primaryTextColor"
            android:textSize="13sp"
            android:padding="8dp"
            android:text="@string/waiting_service_message"/>


        <ir.shecan.ui.widget.CustomButton
            android:id="@+id/btnCheckAgain"
            style="@style/CustomButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/checkAgain" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardBuyService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_round_button"
        app:layout_constraintTop_toBottomOf="@id/cardInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical"
            android:gravity="start">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restart_service"
                android:textColor="@color/primaryTextColor"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingTop="8dp"
                android:paddingHorizontal="16dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primaryTextColor"
            android:textSize="13sp"
            android:padding="8dp"
            android:text="@string/restart_service_description"/>


        <ir.shecan.ui.widget.CustomButton
            android:id="@+id/btnBuyService"
            style="@style/CustomButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="@string/buyService" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardRemaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_round_button"
        app:layout_constraintTop_toBottomOf="@id/cardInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- left: texts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRemainingDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/renew_remaining_sample"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/greenSecondaryTextColor" />

                <LinearLayout
                    android:id="@+id/renewActionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ir.shecan.ui.widget.CustomButton
                        android:id="@+id/btnConnect"
                        style="@style/CustomButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/iran_yekan_light"
                        android:text="@string/connect"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:cb_defaultPadding="0dp"
                        app:cb_secondaryBorderColor="@color/orangeMain"
                        app:cb_secondaryTextColor="@color/orangeMain"
                        app:type="secondary"
                        tools:visibility="visible" />

                    <ir.shecan.ui.widget.CustomButton
                        android:id="@+id/btnRenew"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cb_primaryBackground="@color/colorAccent"
                        app:cb_defaultPadding="0dp"
                        android:text="@string/renew_service"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:fontFamily="@font/iran_yekan_light"
                        android:backgroundTint="@color/orangeMain"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/remainingTimeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remaining_time"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primaryTextColor" />

                <ir.shecan.ui.widget.CircularGlowProgressBar
                    android:id="@+id/customProgress"
                    android:layout_width="120dp"
                    android:layout_height="120dp"/>

                <TextView
                    android:id="@+id/remainingTimeBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="22d 1h 23m"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primaryTextColor" />


            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="50dp"/>

</LinearLayout>
