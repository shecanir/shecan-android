<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_payment_result_dialog"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="30dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/txtPaymentResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/iran_yekan_bakh_vm"
        android:gravity="center"
        android:textColor="@color/greenPrimaryTextColor"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/txtPaymentResultMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/iran_yekan_bakh_vm"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/greenSecondaryTextColor"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnPaymentResultAction"
        android:layout_width="160dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_billing_button_enabled"
        android:fontFamily="@font/iran_yekan_bakh_vm"
        android:gravity="center"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

</LinearLayout>
