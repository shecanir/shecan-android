<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<!--    <FrameLayout-->
<!--        android:id="@+id/frameLayout"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="30dp"-->
<!--        android:layout_gravity="bottom"-->
<!--        android:layout_marginTop="80dp"-->
<!--        android:background="@drawable/bottom_shadow"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <ir.shecan.ui.widget.ShadowLayout
        android:id="@+id/myShadow"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shadowColor="#4a000000"
        app:shadowRadius="10dp"
        app:shadowSize="20dp"
        app:shadowSpread="10dp" />

    <FrameLayout
        android:id="@+id/shadowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_service_panel"
        android:padding="3dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/innerWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_gravity="center">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rootPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:clipToPadding="false"
                android:padding="8dp">

                <FrameLayout
                    android:id="@+id/iconWrap"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_square"
                    android:foregroundGravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivOpen"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="open"
                        android:src="@drawable/ic_open" />
                </FrameLayout>

                <!-- سه ستون متن: هر ستون شامل label کوچک (بالا) و مقدار (پایین) -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/g1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.45" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/g2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.70" />

                <!-- ستون اول: کد سرویس -->
                <LinearLayout
                    android:id="@+id/colOrder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/g2"
                    app:layout_constraintStart_toStartOf="@id/g1"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/labelOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="@string/orderNo"
                        android:textColor="@color/selectedConfigTitleTextColor"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valueOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="۲۹۳۲۸۶۴" />
                </LinearLayout>

                <!-- ستون دوم: نوع سرویس -->
                <LinearLayout
                    android:id="@+id/colService"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/g2"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/labelService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="@string/serviceType"
                        android:textColor="@color/selectedConfigTitleTextColor"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valueService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="برنزی" />
                </LinearLayout>

                <!-- ستون سوم: تاریخ انقضا -->
                <LinearLayout
                    android:id="@+id/colExpire"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/g1"
                    app:layout_constraintStart_toEndOf="@id/iconWrap"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/labelExpire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/expire_date"
                        android:textStyle="bold"
                        android:textColor="@color/selectedConfigTitleTextColor"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valueExpire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/primaryTextColor"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="۱۴۰۴/۰۶/۲۸" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>